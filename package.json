{
  "name": "@claw0gang/antigravity",
  "version": "0.2.6",
  "description": "Independent third-party OpenClaw runtime bridge for the separately installed Google Antigravity CLI (agy); not affiliated with Google or OpenClaw",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run clean && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "openclaw",
    "google-antigravity",
    "agy",
    "agent-harness",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claw0gang/antigravity-plugin.git"
  },
  "homepage": "https://github.com/claw0gang/antigravity-plugin#readme",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2 <2027.0.0",
      "minGatewayVersion": ">=2026.9.2"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2 <2027.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.4",
    "typescript": "^5.9.0"
  }
}
