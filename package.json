{
  "name": "@claw0gang/antigravity",
  "version": "0.3.2",
  "description": "OpenClaw AgentHarnessV2 runtime for Google Antigravity CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "docs/BUILD.md",
    "docs/QUALIFICATION.md",
    "LICENSE",
    "NOTICE.md",
    "RELEASE-NOTES.md"
  ],
  "scripts": {
    "clean": "node tools/build-artifact.mjs --clean",
    "build": "node tools/build-artifact.mjs",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:source": "node --import tsx --import ./tests/source-sdk-loader.mjs --test --test-concurrency=1 tests/*.test.ts",
    "test:build-tools": "node --test tests/build-export.test.mjs",
    "check": "npm run build && npm test && npm run test:build-tools",
    "prepack": "node tools/verify-artifact.mjs --quiet",
    "pack:check": "node tools/check-package.mjs",
    "export:public": "node tools/export-public.mjs",
    "compat:check": "node tools/check-openclaw-compatibility.mjs",
    "qualify": "node tools/qualification.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2",
      "minGatewayVersion": ">=2026.9.2"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "openclaw": "2026.9.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "keywords": [
    "openclaw",
    "google-antigravity",
    "agy",
    "agent-harness",
    "cli-backend",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claw0gang/antigravity-plugin.git"
  },
  "homepage": "https://github.com/claw0gang/antigravity-plugin#readme",
  "bugs": {
    "url": "https://github.com/claw0gang/antigravity-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
