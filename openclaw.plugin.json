{
  "id": "antigravity",
  "name": "Antigravity",
  "description": "Run Google Antigravity CLI through OpenClaw.",
  "providers": [
    "antigravity"
  ],
  "providerCatalogEntry": "./dist/provider-discovery.js",
  "syntheticAuthRefs": [
    "antigravity"
  ],
  "cliBackends": [
    "antigravity-cli"
  ],
  "setup": {
    "cliBackends": [
      "antigravity-cli"
    ],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": true,
    "onProviders": [
      "antigravity"
    ],
    "onAgentHarnesses": [
      "antigravity"
    ]
  },
  "enabledByDefault": false,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string",
        "minLength": 1,
        "description": "AGY executable name or path. Defaults to agy on PATH."
      },
      "printTimeout": {
        "type": "string",
        "minLength": 1,
        "description": "AGY --print-timeout value. Defaults to 30m."
      },
      "sandbox": {
        "type": "boolean",
        "description": "Pass --sandbox to AGY. Enabled by default."
      },
      "dangerouslySkipPermissions": {
        "type": "boolean",
        "description": "Pass --dangerously-skip-permissions to the native harness and compatibility CLI, requesting AGY always-proceed permission mode. Disabled by default; use only for intentionally unrestricted execution."
      },
      "mode": {
        "type": "string",
        "enum": [
          "accept-edits",
          "plan"
        ],
        "description": "AGY execution mode: accept-edits for normal file-editing work or plan for planning-only work. If omitted, AGY uses its own default review behavior."
      },
      "agent": {
        "type": "string",
        "minLength": 1,
        "description": "Optional AGY native agent name passed with --agent. Compatibility CLI can use it directly; native antigravity/* requires a current exact qualified native-agent definition carrier and rejects the setting when that carrier is unavailable."
      },
      "project": {
        "type": "string",
        "minLength": 1,
        "description": "Exact AGY project ID. Required by native antigravity/*; a project resource root must contain the OpenClaw workspace/cwd."
      },
      "newProject": {
        "type": "boolean",
        "description": "Pass --new-project. Do not combine with project; it is not a substitute for the native antigravity/* project binding."
      },
      "addDirs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "description": "Extra directories passed to AGY with --add-dir. Add only paths the workload needs."
      },
      "logFile": {
        "type": "string",
        "minLength": 1,
        "description": "Optional path passed to AGY --log-file; the Gateway must be able to write it."
      }
    }
  },
  "configContracts": {
    "dangerousFlags": [
      {
        "path": "dangerouslySkipPermissions",
        "equals": true
      }
    ]
  },
  "modelCatalog": {
    "providers": {
      "antigravity-cli": {
        "models": [
          {
            "id": "sonnet-4-6",
            "reasoning": false
          },
          {
            "id": "opus-4-6",
            "reasoning": false
          },
          {
            "id": "gpt-oss",
            "reasoning": false
          },
          {
            "id": "gemini-3.8-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.8-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.8-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.7-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.7-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.7-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.6-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.6-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.6-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.5-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.5-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.5-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.1-pro-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.1-pro-low",
            "reasoning": false
          },
          {
            "id": "claude-sonnet-4-6",
            "reasoning": false
          },
          {
            "id": "claude-opus-4-6-thinking",
            "reasoning": false
          },
          {
            "id": "gpt-oss-120b-medium",
            "reasoning": false
          }
        ]
      }
    },
    "discovery": {
      "antigravity": "refreshable",
      "antigravity-cli": "static"
    },
    "runtimeAugment": true
  },
  "skills": [
    "./skills"
  ]
}
