{
  "id": "antigravity",
  "name": "Antigravity",
  "description": "Independent third-party OpenClaw runtime bridge for the separately installed Google Antigravity CLI (agy); not affiliated with Google or OpenClaw.",
  "providers": [
    "antigravity"
  ],
  "providerCatalogEntry": "./dist/provider-discovery.js",
  "syntheticAuthRefs": [
    "antigravity"
  ],
  "cliBackends": [
    "antigravity-cli"
  ],
  "setup": {
    "cliBackends": [
      "antigravity-cli"
    ],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": true,
    "onProviders": [
      "antigravity"
    ],
    "onAgentHarnesses": [
      "antigravity"
    ]
  },
  "enabledByDefault": false,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string",
        "minLength": 1,
        "description": "Google Antigravity CLI executable name or path. Defaults to agy on PATH."
      },
      "printTimeout": {
        "type": "string",
        "minLength": 1,
        "description": "Value passed to AGY as --print-timeout. Defaults to 30m."
      },
      "sandbox": {
        "type": "boolean",
        "description": "Pass --sandbox to AGY. Enabled by default."
      },
      "dangerouslySkipPermissions": {
        "type": "boolean",
        "description": "Explicitly pass --dangerously-skip-permissions to AGY for native and compatibility execution. Disabled by default; enable only for intentionally unrestricted native-tool execution."
      },
      "mode": {
        "type": "string",
        "enum": [
          "accept-edits",
          "plan"
        ],
        "description": "Optional AGY execution mode."
      },
      "agent": {
        "type": "string",
        "minLength": 1,
        "description": "Optional AGY agent selector."
      },
      "project": {
        "type": "string",
        "minLength": 1,
        "description": "Use a specific AGY project for fresh conversations. Mutually exclusive with newProject=true."
      },
      "newProject": {
        "type": "boolean",
        "description": "Start each fresh OpenClaw conversation in a new AGY project. Defaults to false and is mutually exclusive with project."
      },
      "addDirs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "description": "Additional directories exposed to AGY with repeated --add-dir arguments."
      },
      "logFile": {
        "type": "string",
        "minLength": 1,
        "description": "Optional AGY log file path passed with --log-file."
      }
    }
  },
  "configContracts": {
    "dangerousFlags": [
      {
        "path": "dangerouslySkipPermissions",
        "equals": true
      }
    ]
  },
  "modelCatalog": {
    "providers": {
      "antigravity-cli": {
        "models": [
          {
            "id": "sonnet-4-6",
            "reasoning": false
          },
          {
            "id": "opus-4-6",
            "reasoning": false
          },
          {
            "id": "gpt-oss",
            "reasoning": false
          },
          {
            "id": "gemini-3.8-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.8-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.8-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.7-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.7-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.7-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.6-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.6-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.6-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.5-flash-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.5-flash-medium",
            "reasoning": false
          },
          {
            "id": "gemini-3.5-flash-low",
            "reasoning": false
          },
          {
            "id": "gemini-3.1-pro-high",
            "reasoning": false
          },
          {
            "id": "gemini-3.1-pro-low",
            "reasoning": false
          },
          {
            "id": "claude-sonnet-4-6",
            "reasoning": false
          },
          {
            "id": "claude-opus-4-6-thinking",
            "reasoning": false
          },
          {
            "id": "gpt-oss-120b-medium",
            "reasoning": false
          }
        ]
      }
    },
    "discovery": {
      "antigravity": "refreshable",
      "antigravity-cli": "static"
    },
    "runtimeAugment": true
  }
}
